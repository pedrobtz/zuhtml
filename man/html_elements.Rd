\item combinators: descendant (space), child (\code{>}), next sibling (\code{+}) and
later sibling (\code{~}), and selector lists (\verb{,});
\item \verb{:scope}, \verb{:root}, \verb{:empty}, \verb{:first-child}, \verb{:last-child},
\verb{:only-child}, \verb{:nth-child(an+b)}, \verb{:nth-of-type(an+b)}, and \verb{:not()}
