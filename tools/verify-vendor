#!/bin/sh
# Verify that src/vendor/gumbo is the pinned Gumbo archive plus exactly the
# patch series in tools/patches/, byte for byte. Exits non-zero on any
# difference. Run from the package root.
#
#   tools/verify-vendor                 the gate
#   tools/verify-vendor --canary        the gate's canary: re-derive the tree
#                                       with the first patch left out and
#                                       require verification to FAIL
set -eu

CANARY=0
[ "${1:-}" = "--canary" ] && CANARY=1

PROV="src/vendor/PROVENANCE"
[ -f "$PROV" ] || { echo "missing $PROV" >&2; exit 1; }

VERSION=$(awk '/^  Version:/ {print $2}' "$PROV")
EXPECTED=$(awk '/^  SHA-256:/ {print $2}' "$PROV")
URL=$(awk '/^  Archive:/ {print $2}' "$PROV")

echo "==> pinned Gumbo $VERSION"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
FAILURES="$WORK/failures"
: > "$FAILURES"

# --retry, because this runs on every push in CI. Integrity does not rest on
# the transport: the SHA-256 comparison below is what decides.
curl -fsSL --retry 3 --retry-delay 2 --retry-connrefused \
  -o "$WORK/gumbo.tar.gz" "$URL"
ACTUAL=$(shasum -a 256 "$WORK/gumbo.tar.gz" | cut -d' ' -f1)
if [ "$ACTUAL" != "$EXPECTED" ]; then
  echo "FAIL: archive sha256 mismatch" >&2
  echo "  expected $EXPECTED" >&2
  echo "  actual   $ACTUAL" >&2
  exit 1
fi
echo "==> sha256 matches"

tar xzf "$WORK/gumbo.tar.gz" -C "$WORK"
SRC="$WORK/gumbo-parser"
TREE="$WORK/tree"
mkdir "$TREE"

grep -v '^#' tools/gumbo-files.txt | grep -v '^[[:space:]]*$' > "$WORK/paths"
while read -r f; do
  cp "$SRC/$f" "$TREE/$(basename "$f")"
done < "$WORK/paths"

# The patch series must be exactly what PROVENANCE lists, in order.
awk '/^  Local patches:/ {on = 1; next} on && /^ +[^ ]+\.patch$/ {print $1; next} on {exit}' \
  "$PROV" > "$WORK/listed"
ls tools/patches/*.patch 2>/dev/null | xargs -n1 basename > "$WORK/present" || true
if ! cmp -s "$WORK/listed" "$WORK/present"; then
  echo "FAIL: tools/patches/ does not match the patch list in $PROV" >> "$FAILURES"
fi

PRISTINE="$WORK/pristine"
cp -R "$TREE" "$PRISTINE"

first=1
while read -r p; do
  if [ "$CANARY" -eq 1 ] && [ "$first" -eq 1 ]; then
    echo "==> canary: leaving out $p"
    first=0
    continue
  fi
  first=0
  patch -s -p1 -d "$TREE" < "tools/patches/$p" ||
    echo "FAIL: tools/patches/$p does not apply cleanly" >> "$FAILURES"
done < "$WORK/present"
find "$TREE" \( -name '*.orig' -o -name '*.rej' \) -delete

# Every file must match, and nothing may be present that the derivation did
# not produce. Build artefacts are ignored: R builds in place.
count=0
for f in "$TREE"/*; do
  b=$(basename "$f")
  if [ ! -f "src/vendor/gumbo/$b" ]; then
    echo "FAIL: src/vendor/gumbo/$b is missing" >> "$FAILURES"
  elif ! cmp -s "$f" "src/vendor/gumbo/$b"; then
    echo "FAIL: src/vendor/gumbo/$b differs from upstream plus patches" >> "$FAILURES"
  fi
  count=$((count + 1))
done
for local in src/vendor/gumbo/*; do
  b=$(basename "$local")
  case "$b" in
    *.o | *.so | *.dll | *.dylib | *.a) continue ;;
  esac
  [ -f "$TREE/$b" ] ||
    echo "FAIL: src/vendor/gumbo/$b is not in tools/gumbo-files.txt" >> "$FAILURES"
done

# Apache-2.0 section 4(b): every file the series modifies carries a notice
# saying so (tools/patches/0003-modification-notices.patch). Skipped in the
# canary, which leaves a patch out on purpose.
if [ "$CANARY" -eq 0 ]; then
  for f in "$TREE"/*; do
    b=$(basename "$f")
    if ! cmp -s "$f" "$PRISTINE/$b" &&
      ! grep -q "Modified for the zuhtml R package" "$f"; then
      echo "FAIL: $b is modified but carries no modification notice" >> "$FAILURES"
    fi
  done
fi

# The adapter reports the vendored version through zuhtml_info(); it must
# name the version pinned here.
if ! grep -q "#define ZUH_GUMBO_VERSION \"$VERSION\"" src/zuh_gumbo.c; then
  echo "FAIL: ZUH_GUMBO_VERSION in src/zuh_gumbo.c is not \"$VERSION\"" >> "$FAILURES"
fi

if [ "$CANARY" -eq 1 ]; then
  if [ -s "$FAILURES" ]; then
    echo "==> canary OK: verification failed with a patch left out"
    exit 0
  fi
  echo "CANARY FAILED: verification passed with a patch left out" >&2
  exit 1
fi

if [ -s "$FAILURES" ]; then
  cat "$FAILURES" >&2
  echo "==> vendor tree FAILED verification" >&2
  exit 1
fi

echo "==> vendor tree verified ($count files, Gumbo $VERSION plus $(wc -l < "$WORK/present" | tr -d ' ') patches)"
